#!/usr/bin/env zsh

gnu_utils=(
  coreutils
  findutils
  #inetutils
  gnu-sed
  grep
)

# Homebrew
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/opt/homebrew/sbin:$PATH"

# GNU utils
for gnu_path in ${gnu_utils[@]}; do
  export PATH="/opt/homebrew/opt/${gnu_path}/libexec/gnubin:$PATH"
done

# Zsh completions
fpath=(/usr/local/share/zsh-completions $fpath)
